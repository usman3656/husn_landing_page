# Husn landing-page environment variables.

# Demo form endpoint (Formspree)
# 1. Sign up at https://formspree.io and create a form
# 2. Copy the endpoint URL — looks like https://formspree.io/f/abcd1234
# 3. Paste below for local dev, AND add as a GitHub Actions secret
#    named NEXT_PUBLIC_FORM_ENDPOINT for production.
# If unset/kept as placeholder, the form falls back to a mailto: link.
NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Plausible (page analytics, no cookies, no consent required)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=husn.io

# PostHog (event analytics, consent-gated)
NEXT_PUBLIC_POSTHOG_KEY=phc_stub_xxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 (consent-gated, sets cookies). Measurement id like G-XXXXXXXXXX.
# Leave unset to disable GA entirely.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (the content value of the
# google-site-verification meta tag). Leave unset until you verify the domain.
NEXT_PUBLIC_GSC_VERIFICATION=

# Demo booking — Calendly (or Cal.com) scheduling link embedded on the page.
# Create the booking type in Calendly under the notbawany1@gmail.com account
# (Calendly handles slot availability + sends the confirmations and calendar
# invites), then paste its public URL here. Inlined at build time.
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/YOUR-HANDLE/30min
